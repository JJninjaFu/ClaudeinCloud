ship = Hard Hat Heavy
version = 1.12.5
description = Hard Hat Heavy: 3-kerbal Mk1-3 crew rocket, 6 stages, all stock (KSP 1.12). Stage order: [5] Mainsail + 4 Kickbacks (80% thrust) liftoff, [4] TT-70s kick the Kickbacks loose while 8 Sepratrons retro-fire their noses outward, [3] pop the launch escape tower, [2] drop the core and light the Poodle, [1] pod separation, [0] 4 radial chutes. About 7 km/s vacuum dV: orbit with the core, then the Poodle has around 3.7 km/s for a Mun or Minmus trip and home. ABORT (Backspace): cuts the liquid engines, blows the pod off the stack and fires the escape tower; then stage off the tower and pop chutes. Gravity turn at 60-80 m/s, about 45 degrees by 10 km.
type = VAB
size = 5.8,24.2,5.8
steamPublishedFileId = 0
persistentId = 2511742118
rot = 0,0,0,1
missionFlag = Squad/Flags/default
vesselType = Ship
